# fd, rg and dust take different flags from the tools they stand in for, and as
# aliases they broke shell startup: sdkman-init.sh runs `find ... -type f`, which
# fd reads as `-t ype`. `grep -r x .` is the same trap - rg's -r is --replace.
#
# Functions instead, because an alias is expanded while a file is being *parsed*,
# so every sourced script inherits it, while a function is resolved at call time
# and can look at what it was actually handed. A call carrying classic syntax is
# passed to the original; anything else gets the replacement. So typing `find foo`
# searches with fd, and sdkman keeps working.
#
# `command find` reaches the original. A leading backslash does not: that skips
# aliases, and these are functions.
# A shell that loaded the earlier alias version of these cannot parse a function
# of the same name - zsh refuses with "defining function based on alias" - so a
# re-source (`rr`) would fail where a fresh shell was fine. Same guard as `init`
# above.
unalias du find grep 2>/dev/null

# $1 exact tokens, $2 short letters that may arrive bundled (`du -sh`, `grep -rn`),
# then the call's own arguments.
_classic_call() {
    local exact=" ${1} " bundled="$2" argument character
    shift 2

    for argument in "$@"; do
        [[ $exact == *" $argument "* ]] && return 0

        if [[ -n $bundled && $argument == -[!-]* ]]; then
            for (( character = 2; character <= ${#argument}; character++ )); do
                [[ $bundled == *${argument[character]}* ]] && return 0
            done
        fi
    done

    return 1
}

find() {
    # Single-dash long predicates - fd has no -type, and reads -depth as -d epth.
    # No bundled set: find's classic syntax is always a whole word.
    local exact='-type -name -iname -path -ipath -regex -iregex -exec -execdir -ok
        -delete -print -print0 -printf -maxdepth -mindepth -size -perm -user -group
        -links -inum -empty -prune -depth -ls -newer -newermt -mtime -atime -ctime
        -mmin -amin -cmin'
    _classic_call "$exact" '' "$@" && { command find "$@"; return; }
    fd "$@"
}

grep() {
    # -r/-R are the dangerous ones: rg is recursive already and spells -r --replace.
    local exact='--recursive --include --exclude --exclude-dir --directories --null
        --devices --no-messages'
    _classic_call "$exact" 'rRdZ' "$@" && { command grep "$@"; return; }
    rg "$@"
}

du() {
    # dust always draws a tree; -s, -h and the unit flags have no equivalent.
    local exact='--summarize --human-readable --all --total --one-file-system --max-depth'
    _classic_call "$exact" 'shackmgx' "$@" && { command du "$@"; return; }
    dust "$@"
}

ts() {
    npx tsc --noEmit && npx tsx "$@"
  }


