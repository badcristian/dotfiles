# ─── VI MODE ─────────────────────────────────────────── added 2026-08-05 ────
# Vi keybindings on the command line. Press Esc to leave typing and get Vim
# motions: b w 0 $ to move, ciw to change a word, cia to change a whole shell
# argument, D to kill to the end, u to undo. i or a returns to typing.
#
# This is not a new preference so much as an unset variable being corrected:
# zsh and tmux both pick emacs keys unless $EDITOR or $VISUAL contains "vi",
# and both were empty. Starship already carried a vimcmd_symbol that could
# never fire. Setting the editor here also gives git, less, and crontab nvim.
#
# TO REVERT: delete this whole block. Nothing else depends on it.
#
# Must stay ABOVE the bindkey on the next few lines: a bindkey without -M
# targets whichever keymap is current, so ^X^E would land in the emacs keymap
# and be unreachable if the switch happened afterwards.
export EDITOR=nvim
export VISUAL=nvim
bindkey -v
# Esc registers instantly instead of after zsh's default 0.4s wait.
KEYTIMEOUT=1
# Escape hatches: vi mode turns these two into self-insert, which would silently
# break muscle memory. DELETE JUST THESE TWO LINES for a pure-vi command line.
# (^A is absent on purpose: tmux takes it as the prefix, so it never arrives.)
bindkey -M viins '^E' end-of-line
bindkey -M viins '^K' kill-line
# zsh's viins keymap uses the vi-* delete widgets, and every one of them refuses
# to delete back past the point where insert mode began. Real vi behaves this
# way, but in a shell it means Backspace goes dead on any text typed before the
# last Esc, and Cmd-Backspace stops clearing the whole line. Swap in the plain
# widgets so deleting always reaches the start of the line.
bindkey -M viins '^?' backward-delete-char
bindkey -M viins '^H' backward-delete-char
bindkey -M viins '^U' kill-whole-line
bindkey -M viins '^W' backward-kill-word
bindkey -M viins '^[^?' backward-kill-word
# y and Y fill only $CUTBUFFER, zsh's own register, which p and P can paste but
# nothing outside the line editor can see — so V then y looks like a copy and
# leaves the system clipboard untouched. Mirror each yank to pbcopy as well.
# vicmd is the right keymap for both forms: visual-line-mode does not switch
# keymaps, it sets REGION_ACTIVE and stays in vicmd, so this one binding covers
# V then y as well as a bare y with a motion.
# Deletes are deliberately not mirrored, matching Vim, where d and x fill the
# unnamed register without touching the system clipboard.
vi-yank-clipboard() {
	zle vi-yank
	printf '%s' "$CUTBUFFER" | pbcopy
}
zle -N vi-yank-clipboard

vi-yank-whole-line-clipboard() {
	zle vi-yank-whole-line
	printf '%s' "$CUTBUFFER" | pbcopy
}
zle -N vi-yank-whole-line-clipboard

bindkey -M vicmd 'y' vi-yank-clipboard
bindkey -M vicmd 'Y' vi-yank-whole-line-clipboard

