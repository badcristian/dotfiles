# Match Starship to macOS appearance when a shell starts. Use
# `prompt-theme light|dark|auto` to switch an already-open shell.
_macos_effective_appearance() {
  local appearance_cache="$HOME/.cache/macos-effective-appearance"
  local appearance

  if [[ -r "$appearance_cache" ]]; then
    IFS= read -r appearance < "$appearance_cache"
  else
    appearance=$(/usr/bin/osascript -l JavaScript -e \
      'ObjC.import("AppKit"); $.NSApplication.sharedApplication.effectiveAppearance.name.js' \
      2>/dev/null)
    [[ "$appearance" == *Dark* ]] && appearance="dark" || appearance="light"
  fi

  print -r -- "$appearance"
}

_select_starship_theme() {
  local selected_theme="${STARSHIP_THEME:-auto}"

  if [[ "$selected_theme" == "auto" ]]; then
    if [[ "$(_macos_effective_appearance)" == "dark" ]]; then
      selected_theme="dark"
    else
      selected_theme="light"
    fi
  fi

  if [[ "$selected_theme" == "light" ]]; then
    export STARSHIP_CONFIG="$HOME/.config/starship-light.toml"
  else
    export STARSHIP_CONFIG="$HOME/.config/starship.toml"
  fi

  STARSHIP_ACTIVE_THEME="$selected_theme"
}

prompt-theme() {
  case "${1:-}" in
    light|dark)
      export STARSHIP_THEME="$1"
      ;;
    auto)
      unset STARSHIP_THEME
      ;;
    *)
      echo "Usage: prompt-theme light|dark|auto"
      return 2
      ;;
  esac

  _select_starship_theme
  echo "Starship theme: $STARSHIP_ACTIVE_THEME"
}

_select_starship_theme

# use Starship instead of Geometry
# starship's init wraps any pre-existing zle-keymap-select widget so it can add
# its own prompt redraw. Re-sourcing this file makes it wrap its own wrapper,
# and from the second reload onwards that wrapper calls itself: every Esc then
# prints "maximum nested function level reached" and tears the prompt redraw in
# half. Clearing the widget and starship's saved handle first makes sourcing
# this file idempotent, so `rr` is safe to run as often as you like.
unset __starship_preserved_zle_keymap_select
zle -D zle-keymap-select 2>/dev/null
eval "$(starship init zsh)"

