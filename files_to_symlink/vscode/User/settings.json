	"intelephense.environment.includePaths": [],
	"intelephense.environment.phpVersion": "8.4.0",
	// Licence key intentionally NOT stored here (this file is version-controlled).
	// Activate Premium via Command Palette → "Intelephense: Enter licence key",
	// which persists it to the extension's global storage, outside the repo.
	"php.suggest.basic": false,
	// "intelephense.diagnostics.undefinedMethods": false,
	"files.exclude": {
		// "**/vendor": true
	},
	"search.exclude": {
		"**/dist": true,
		"**/.output": true,
		"**/target/**": true,
		"**/vendor/**": true,
		"**/*.map": true,
		"**/package-lock.json": true,
		"**/_ide_helper.php": true,
	},
	"search.maxResults": 200,
	// Filesystem watching is its own consumer, separate from search and from
	// Intelephense indexing. VS Code's defaults only cover node_modules and
	// .git/objects, which leaves vendor/ and the generated storage trees fully
	// watched: 178,810 unguarded files in spro-marketing and 25,157 in
	// ribeit-api, measured with find. Excluding them here does not affect
	// Intelephense, which still indexes vendor/ for completion; vendor only
	// changes on composer install. storage/app stays watched because real
	// source lives there, such as storage/app/scripts.
	"files.watcherExclude": {
		"**/vendor/**": true,
		"**/node_modules/**": true,
		"**/.git/**": true,
		"**/storage/clockwork/**": true,
		"**/storage/debugbar/**": true,
		"**/storage/framework/**": true,
		"**/storage/logs/**": true,
		"**/bootstrap/cache/**": true,
		"**/dist/**": true,
		"**/.output/**": true,
		"**/target/**": true,
	},
	"window.restoreWindows": "all",
	"intelephense.files.exclude": [
		"**/.git/**",
		"**/.svn/**",
		"**/.hg/**",
		"**/CVS/**",
		"**/.DS_Store/**",
		"**/node_modules/**",
		"**/bower_components/**",
		"**/dist/**",
		"**/vendor/**/{Tests,tests}/**",
		"**/vendor/**/vendor/**",
		// A Nova component is a Composer package living inside the app, and each one
		// installs its OWN vendor tree: eleven of them in spro-marketing, 7,300–8,700 PHP
		// files apiece, 78,522 in total against the 2–32 files of first-party code they
		// exist for. Every one of those trees is another copy of Laravel, Nova and Symfony
		// that the root vendor/ already provides, so indexing them buys nothing and costs
		// most of the index: they were 57% of the 137,767 files Intelephense was loading,
		// and the reason its language server sat at 1.8 GB.
		// `**/vendor/**/vendor/**` above does not reach them — the outer directory is
		// `nova-components`, not `vendor`.
		// Duplicate symbols are the second cost: eleven Application classes make Cmd+B
		// ambiguous where one would be exact.
		"**/nova-components/*/vendor/**",
		// google/apiclient-services ships one generated class tree per Google API: 327 of them,
		// 35,734 PHP files, against the five services this codebase actually names. Excluding the
		// package wholesale would break `Google\Service\SearchConsole` and friends, so the used
		// five are held back by name and the other 322 — 35,355 files — go.
		// The extglob negation is not a guess: Intelephense bundles micromatch, and this pattern
		// was checked against it directly. If a service is added to the code, add it here too, or
		// its classes will read as undefined.
		"**/vendor/google/apiclient-services/src/!(BusinessProfilePerformance|MyBusinessAccountManagement|MyBusinessBusinessInformation|SearchConsole|YouTube)/**",
		"**/vendor/_laravel_idea/**",
		"**/_laravel_ide/**",
		// NOTE: barryvdh's _ide_helper.php (facade/macro stubs) is intentionally NOT excluded —
		// Intelephense must index it to resolve facade & concrete-adapter methods like
		// Storage::disk('local')->buildTemporaryUrlsUsing(). It stays in references.exclude below
		// so it never clutters Find References. Only the MODEL + phpstorm.meta stubs stay excluded:
		// those duplicate Eloquent classes and reintroduce the P1119 "too many arguments" bug.
		"**/_ide_helper_models.php",
		"**/_ide_helper_models_*.php",
		"**/.phpstorm.meta.php",
		// Laravel runtime/generated artifacts — never real source. Excluding them stops Intelephense
		// reporting P1008 "Undefined variable $__env/$slot" on compiled Blade views, etc.
		"**/storage/framework/**",
		"**/bootstrap/cache/**",
	],
