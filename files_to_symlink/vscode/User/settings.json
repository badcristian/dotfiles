	"workbench.activityBar.compact": true,
	// Turn on the cap
	"workbench.editor.limit.enabled": true,
	// Max number of open tabs
	"workbench.editor.limit.value": 10,
	// Apply the limit per editor group (split pane) instead of globally
	"workbench.editor.limit.perEditorGroup": true,
	// Don't auto-close tabs with unsaved changes
	"workbench.editor.limit.excludeDirty": true,
	// SonarLint lints every file you OPEN, independent of intelephense.files.exclude.
	// Since Go-to-Definition now jumps into the generated _ide_helper.php (facade stubs),
	// and Blade compiles into storage/framework/views, exclude all generated/build artifacts
	// so SonarLint stops flooding Problems with php:S836 etc. on code you never hand-edit.
	"sonarlint.analysisExcludesStandalone": "**/_ide_helper.php,**/_ide_helper_manual.php,**/_ide_helper_models.php,**/_ide_helper_models_*.php,**/.phpstorm.meta.php,**/storage/framework/**,**/bootstrap/cache/**,**/vendor/**,**/node_modules/**,**/*.min.js",
	"sonarlint.rules": {
		"php:S116": {
			"level": "off",
		},
		"php:S100": {
			"level": "off",
		},
		"php:S115": {
			"level": "off",
		},
		"java:S106": {
			"level": "off",
		},
		"php:S5693": {
			"level": "off",
		},
		"php:S1172": {
			"level": "off",
		},
		"php:S1192": {
			"level": "off",
		},
		"php:S138": {
			"level": "off",
		},
		"php:S1131": {
			"level": "off",
		},
		"php:S3776": {
			"level": "off",
		},
		"php:S1448": {
			"level": "off",
		},
		"php:S1186": {
			"level": "off",
		},
		"php:S1135": {
			"level": "off",
		},
		"php:S112": {
			"level": "off",
		},
		"php:S1142": {
			"level": "off",
		},
		"php:S125": {
			"level": "off",
		},
		"php:S107": {
			"level": "off",
		},
		"typescript:S2486": {
			"level": "off",
		},
	},
	// Error Lens: keep native squiggles only — no inline message text
	"errorLens.messageEnabled": false,
	"errorLens.gutterIconsEnabled": false,
	"git.blame.editorDecoration.enabled": true,
	"git.blame.statusBarItem.enabled": true,
	"yaml.disableSchemaDetection": [
