	// Workbench CSS and JS, injected by be5invis.vscode-custom-css from the symlinked User folder.
	// Editing a listed file requires "Reload Custom CSS and JS" and a restart; the loader inlines
	// their contents into workbench.html rather than linking to them.
	"vscode_custom_css.imports": [
		"file:///Users/mac/Library/Application%20Support/Code/User/custom-workbench.css",
		"file:///Users/mac/Library/Application%20Support/Code/User/custom-preserve-editor-horizontal-scroll.js",
		"file:///Users/mac/Library/Application%20Support/Code/User/custom-anchor-quick-input-to-command-center.js",
	],
