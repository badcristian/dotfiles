	// },
	// "Laravel.pint.runOnSave": true,
	"laravel-pint.enable": true,
	// "editor.formatOnSave": true,
	"editor.tokenColorCustomizations": {
		"textMateRules": [
			{
				"scope": [
					"comment",
					"punctuation.definition.comment",
					"markup.italic",
					"keyword",
					"keyword.control",
					"keyword.operator",
					"storage.type",
					"storage.modifier",
					"variable.language",
					"variable.parameter",
					"entity.other.attribute-name",
					"entity.name.tag",
					"support.type.primitive",
				],
				"settings": {
					"fontStyle": "",
				},
			},
			{
				// The theme's italic on PHPDoc keywords survives the rule above, because
				// it is written as the descendant selector
				// `comment.block.documentation.phpdoc.php keyword` and TextMate resolves
				// by selector specificity, not by who was applied last. A single-segment
				// `keyword` override can never win against it. Repeating the theme's
				// selector verbatim ties on specificity, and the customization is applied
				// second, so it takes the tie.
				"scope": [
					"comment.block.documentation.phpdoc.php keyword",
				],
				"settings": {
					"fontStyle": "",
				},
			},
		],
		// Docblocks were a flat wall of #737994 on #303446 — 2.9:1, below every
		// legibility floor, with every reference, tag and code span the same grey.
		// Prose is lifted to Subtext0 (5.6:1) and the three things that name code get
		// their own colour, so a docblock can be skimmed for structure:
		//   prose      #a5adce   5.6:1
		//   @tag       #ca9ee6   theme mauve, unchanged
		//   reference  #8caaee   5.4:1   {@see Foo}, {@see Foo::bar()}
		//   code span  #a6d189   7.1:1   `$e->response`
