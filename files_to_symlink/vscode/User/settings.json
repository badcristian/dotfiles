  "explorer.decorations.colors": true,
  "problems.decorations.enabled": false,
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "folder-color.useGlobalSettings": false,
  "workbench.iconTheme": "phpstorm-icon",
  // "[php]": {
  // 	// "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
  // 	"editor.defaultFormatter": "open-southeners.laravel-pint",
  // },
  // global settings.json
  "[php]": {
    "editor.defaultFormatter": "open-southeners.laravel-pint",
    "editor.inlayHints.enabled": "off",
  },
  "[hack]": {
    "editor.inlayHints.enabled": "off",
  },
  // // per-project .vscode/settings.json in Laravel repos
  // "[php]": {
  // 	"editor.defaultFormatter": "open-southeners.laravel-pint",
  // },
  // "Laravel.pint.runOnSave": true,
  "laravel-pint.enable": true,
  // "editor.formatOnSave": true,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": [
          "comment",
          "punctuation.definition.comment",
          "markup.italic",
          "keyword",
          "keyword.control",
          "keyword.operator",
          "storage.type",
          "storage.modifier",
          "variable.language",
          "variable.parameter",
          "entity.other.attribute-name",
          "entity.name.tag",
          "support.type.primitive",
        ],
        "settings": {
          "fontStyle": "",
        },
      },
      {
        // The theme's italic on PHPDoc keywords survives the rule above, because
        // it is written as the descendant selector
        // `comment.block.documentation.phpdoc.php keyword` and TextMate resolves
        // by selector specificity, not by who was applied last. A single-segment
        // `keyword` override can never win against it. Repeating the theme's
        // selector verbatim ties on specificity, and the customization is applied
        // second, so it takes the tie.
        "scope": ["comment.block.documentation.phpdoc.php keyword"],
        "settings": {
          "fontStyle": "",
        },
      },
    ],
    // Docblocks were a flat wall of #737994 on #303446 — 2.9:1, below every
    // legibility floor, with every reference, tag and code span the same grey.
    // Prose is lifted to Subtext0 (5.6:1) and the three things that name code get
    // their own colour, so a docblock can be skimmed for structure:
    //   prose      #a5adce   5.6:1
    //   @tag       #ca9ee6   theme mauve, unchanged
    //   reference  #8caaee   5.4:1   {@see Foo}, {@see Foo::bar()}
    //   code span  #a6d189   7.1:1   `$e->response`
    // The reference and code-span scopes come from the local PHPDoc injection in
    // `local.smart-references`; see the change-history entry for why they exist.
    "[Catppuccin Noctis Frappé]": {
      "comments": "#a5adce",
      "textMateRules": [
        {
          "scope": ["markup.inline.raw.phpdoc.php"],
          "settings": {
            "foreground": "#a6d189",
          },
        },
        {
          "scope": [
            "meta.tag.inline.phpdoc.php entity.name.type.class.php",
            "meta.tag.inline.phpdoc.php entity.name.function.php",
            "meta.tag.inline.phpdoc.php variable.other.property.php",
          ],
          "settings": {
            "foreground": "#8caaee",
          },
        },
        {
          // Braces, backticks and `::` are scaffolding: readable, but kept
          // below the words they wrap so they do not compete with them.
          "scope": [
            "punctuation.definition.raw.phpdoc.php",
            "punctuation.definition.tag.begin.phpdoc.php",
            "punctuation.definition.tag.end.phpdoc.php",
            "punctuation.definition.arguments.phpdoc.php",
            "meta.tag.inline.phpdoc.php punctuation.separator.inheritance.php",
          ],
          "settings": {
            "foreground": "#838ba7",
          },
        },
      ],
    },
    // Same three roles in the light theme, which is already legible at 4.9:1 and
    // therefore only needs the structure, not the contrast lift.
    "[GitHub Light]": {
      "textMateRules": [
        {
          "scope": ["markup.inline.raw.phpdoc.php"],
          "settings": {
            "foreground": "#0a7b45",
          },
        },
        {
          "scope": [
            "meta.tag.inline.phpdoc.php entity.name.type.class.php",
            "meta.tag.inline.phpdoc.php entity.name.function.php",
            "meta.tag.inline.phpdoc.php variable.other.property.php",
          ],
          "settings": {
            "foreground": "#0550ae",
          },
        },
        {
          "scope": [
            "punctuation.definition.raw.phpdoc.php",
            "punctuation.definition.tag.begin.phpdoc.php",
            "punctuation.definition.tag.end.phpdoc.php",
            "punctuation.definition.arguments.phpdoc.php",
            "meta.tag.inline.phpdoc.php punctuation.separator.inheritance.php",
          ],
          "settings": {
            "foreground": "#8c959f",
          },
        },
      ],
    },
  },
  "bookmarks.wrapNavigation": false,
  "bookmarks.sideBar.expanded": true,
  "bookmarks.sideBar.hideWelcome": true,
  // The left icon column is gone: the Explorer/Search/SCM/Extensions icons move into the title bar
  // row, beside the command center, so they cost no horizontal or vertical space and stay one click
  // away. Hover-to-reveal was what was actually wanted and is not available — the part sits in a
  // `.monaco-grid-view` leaf whose size is computed in JS, so CSS can shrink the bar but not
  // reclaim its cell, and the built-in toggle command persists this very key, which would rewrite
  // a settings.json that is a symlink into this repository.
  // "hidden", not "top": the top strip still costs a ~35px band of its own above the sidebar, and
  // the icons in it were not being used. Removing the part lifts the Explorer by that band. The
  // views that lost their icons are reachable by key instead — Shift+Cmd+1 Explorer, Shift+Cmd+X
  // Extensions/Remote toggle — which is the trade this option was previously refused over.
  "workbench.activityBar.location": "hidden",
  // Only read when location is "default"; kept so switching back stays a one-line change.
  "workbench.activityBar.compact": true,
  // Tailwind's @apply / @tailwind / @screen are not CSS at-rules, and VS Code's built-in style
  // validator only knows the standard ones — so every @apply reports "Unknown at rule". Tailwind
  // CSS IntelliSense is installed and supplies completions for them, but it does not silence this
  // validator; the lint rule is the documented fix. Scoped to this one rule rather than turning
  // style validation off, so genuine CSS mistakes are still reported.
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",
  "less.lint.unknownAtRules": "ignore",
  // Turn on the cap
  "workbench.editor.limit.enabled": true,
  // Max number of open tabs
  "workbench.editor.limit.value": 8,
  // Apply the limit per editor group (split pane) instead of globally
  "workbench.editor.limit.perEditorGroup": true,
  // Don't auto-close tabs with unsaved changes
  "workbench.editor.limit.excludeDirty": true,
  // Error Lens: keep native squiggles only — no inline message text
  "errorLens.messageEnabled": false,
  "errorLens.gutterIconsEnabled": false,
  // The built-in Git decoration only annotates the active line. GitLens File Blame renders the
  // PhpStorm-like per-line author column and is deliberately toggled from the editor toolbar.
  "git.blame.editorDecoration.enabled": false,
  "git.blame.statusBarItem.enabled": true,
  "gitlens.fileAnnotations.command": "blame",
  "gitlens.currentLine.enabled": false,
  "gitlens.defaultCurrentUserNameStyle": "name",
  // Pad the author to a fixed 14 columns so every annotation row is exactly 14 + 1 + 10
  // characters wide. Without the width GitLens sizes each row to its own text, and the
  // per-row background ends at a different column on every line. Longer names truncate
  // with an ellipsis; raise the number to fit them.
  "gitlens.blame.format": "${author|14} ${date}",
  "gitlens.blame.dateFormat": "YYYY-MM-DD",
  "gitlens.blame.compact": false,
  "gitlens.blame.heatmap.enabled": false,
  "gitlens.blame.highlight.enabled": false,
  "yaml.disableSchemaDetection": [
    "**/docker-compose.yml",
    "**/docker-compose.yaml",
    "**/docker-compose.*.yml",
    "**/docker-compose.*.yaml",
    "**/compose.yml",
    "**/compose.yaml",
    "**/compose.*.yml",
    "**/compose.*.yaml",
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml",
  ],
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "js/ts.updateImportsOnFileMove.enabled": "always",
  // Ceiling for the TS server heap, not a reservation. The default is 3072, and V8
  // only collects seriously as it nears the ceiling -- so the default lets a Nuxt
  // project idle around a gigabyte. 2048 makes it collect sooner while leaving
  // roughly 2x headroom over what those projects actually use. If the server starts
  // dying with "terminated unexpectedly", it needs more than this, not less.
  "typescript.tsserver.maxTsServerMemory": 2048,
  "extensions.supportAgentsWindow": {
    "monokai.theme-monokai-pro-vscode": true,
  },
  "claudeCode.preferredLocation": "panel",
  "chat.unifiedAgentsBar.enabled": true,
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.browser.showInTitleBar": false,
  "window.commandCenter": false,
  "workbench.editor.enablePreview": false,
  "workbench.statusBar.visible": false,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
}
