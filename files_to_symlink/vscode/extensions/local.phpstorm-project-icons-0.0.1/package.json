{
  "name": "phpstorm-project-icons",
  "displayName": "PhpStorm Project Icons",
  "version": "0.0.2",
  "publisher": "local",
  "engines": {
    "vscode": "^1.60.0"
  },
  "activationEvents": [
    "onCommand:phpstormProjectIcons.refresh"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "phpstormProjectIcons.refresh",
        "title": "PhpStorm Icons: Refresh PHP File Icons From Workspace"
      }
    ]
  }
}
