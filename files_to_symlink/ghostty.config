font-family = JetBrains Mono
font-family-bold = JetBrains Mono
font-family-italic = JetBrains Mono
font-family-bold-italic = JetBrains Mono
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
adjust-cell-height = 0%
# Keep manual macOS resizing aligned to whole terminal cells so the final tmux
# row does not acquire a resize-dependent strip of leftover pixels.
window-step-resize = true
# Preserve the small titlebar-side inset, but do not add explicit padding below
# tmux's final row.
window-padding-y = 2,0
window-padding-balance = true
# Starting size for the first window on a display Hammerspoon has no remembered
# size for. After that the Ghostty section of init.lua owns window geometry: it
# centers each new window and reuses the size left by the last manual resize.
# `window-position-x` / `window-position-y` are deliberately unset, since they
# only accept fixed pixel coordinates and go stale the moment the size or the
# display changes.
window-height = 50
window-width = 160
# Kept at `never` so relaunching starts clean; the remembered size lives in
# Hammerspoon's settings rather than in a restored macOS session.
window-save-state = never
# Fallback only. The live choice lives in the generated `theme.ghostty`
# included at the bottom of this file; pick it from the tmux popup.
theme = dark:Catppuccin Macchiato,light:Catppuccin Latte
# Measured with Chrome closed and the machine idle, sampling `top -l 2`
# intervals: this shader is free. Energy impact was 9.6 with it and 9.9 with no
# shader at all, which is inside the run-to-run spread. custom-shader-animation
# is therefore left at its default of true, so the trail actually animates —
# setting it false changed nothing measurable and only stopped the motion.
#
# The moving-stars background is the one that costs: 17.3 against 9.9, about
# 1.7x, because the generated theme loads a second shader with animation =
# always, which keeps drawing even when the window is unfocused. Toggle it from
# the tmux popup rather than here.
# DIAGNOSTIC 2026-09-02: off while testing whether the shader is what leaves
# stale pane rows over a tmux popup's top rows. Uncomment to restore.
# custom-shader = shaders/cursor_warp.glsl
macos-icon = holographic
# Only reaches the Dock and the app switcher, via NSApplication.icon. Finder
# always draws the icon signed into the bundle, so it stays the official ghost.
#
# The titlebar icon is a different feature: macOS draws a proxy icon for the
# window's represented URL, which Ghostty sets to the pane's working directory,
# so it renders as a plain folder next to whatever title the program set. There
# is no way to substitute a different image for it: the proxy icon is always the
# icon of the directory itself, so the only lever is showing it or not. Hidden
# because the folder says nothing the prompt does not already show.
#
# Takes effect on the next working-directory change, not on config reload.
macos-titlebar-proxy-icon = hidden

# The ghost is Ghostty's own placeholder title, baked into every window nib and
# normally visible for about a tenth of a second while the shell starts up.
# Pinning it here just makes it stay. With the proxy icon hidden it sits right
# after the traffic lights, which is where that flash appears.
#
# Setting `title` fixes it: Ghostty then ignores the title escape sequences that
# programs send, so the bar no longer reports the working directory or what is
# running. That is the trade, and it is deliberate - this titlebar is decoration.
title = "👻"

# Send Command shortcuts to tmux as their existing Meta equivalents.
keybind = super+p=esc:p
keybind = super+n=esc:n
keybind = super+u=esc:u
keybind = super+k=esc:k
keybind = super+,=esc:,
keybind = super+.=esc:.
keybind = super+arrow_left=esc:,
keybind = super+arrow_right=esc:.
# Use otherwise-unused function-key sequences for Notes navigation. Unlike an
# Alt/escape chord, these stay distinct from plain Escape inside Neovim.
keybind = super+arrow_up=csi:25~
keybind = super+arrow_down=csi:26~
keybind = super+/=esc:/

# Preserve Ghostty's new-window action on the shifted shortcut.
keybind = super+shift+n=new_window

background-opacity = 0.97

# Runtime theme choice generated by tmux-theme.sh. When the moving background is
# on it names `starfield-active`, a theme the script builds by appending
# ghostty/stars-overlay.conf to whichever dark theme is selected - which is why
# the stars are no longer tied to Catppuccin.
config-file = ?theme.ghostty
