font-family = JetBrains Mono
font-family-bold = JetBrains Mono
font-family-italic = JetBrains Mono
font-family-bold-italic = JetBrains Mono
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
adjust-cell-height = 0%
# Keep manual macOS resizing aligned to whole terminal cells so the final tmux
# row does not acquire a resize-dependent strip of leftover pixels.
window-step-resize = true
# Preserve the small titlebar-side inset, but do not add explicit padding below
# tmux's final row.
window-padding-y = 2,0
window-padding-balance = true
# Starting size for the first window on a display Hammerspoon has no remembered
# size for. After that the Ghostty section of init.lua owns window geometry: it
# centers each new window and reuses the size left by the last manual resize.
# `window-position-x` / `window-position-y` are deliberately unset, since they
# only accept fixed pixel coordinates and go stale the moment the size or the
# display changes.
window-height = 50
window-width = 160
# Kept at `never` so relaunching starts clean; the remembered size lives in
# Hammerspoon's settings rather than in a restored macOS session.
window-save-state = never
theme = dark:Catppuccin Macchiato Stars,light:Catppuccin Latte
custom-shader = shaders/cursor_warp.glsl
# The shader samples iTime, which makes Ghostty repaint every frame for as long
# as the window is focused, whether or not anything changed. That was ~36% of a
# core in WindowServer plus ~17% in Ghostty, permanently, and it is what made
# the laptop run hot. false keeps the shader loaded but stops the free-running
# repaint; the cursor trail no longer animates. Remove both lines to drop it.
custom-shader-animation = false
macos-icon = retro

# Send Command shortcuts to tmux as their existing Meta equivalents.
keybind = super+p=esc:p
keybind = super+n=esc:n
keybind = super+u=esc:u
keybind = super+k=esc:k
keybind = super+,=esc:,
keybind = super+.=esc:.
keybind = super+arrow_left=esc:,
keybind = super+arrow_right=esc:.
# Use otherwise-unused function-key sequences for Notes navigation. Unlike an
# Alt/escape chord, these stay distinct from plain Escape inside Neovim.
keybind = super+arrow_up=csi:25~
keybind = super+arrow_down=csi:26~
keybind = super+/=esc:/

# Preserve Ghostty's new-window action on the shifted shortcut.
keybind = super+shift+n=new_window

background-opacity = 0.97

# Runtime dark-background choice generated by tmux-background.sh.
config-file = ?background.ghostty
